{
  "name": "hexmind-app",
  "version": "1.3.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "cap:add:ios": "pnpm exec cap add ios",
    "cap:build": "pnpm build && pnpm exec cap sync ios",
    "cap:open": "pnpm exec cap open ios",
    "cap:sync:android": "pnpm build && CAPACITOR_APP_ID=app.ideatiles.android pnpm exec cap sync android",
    "android:test": "pnpm cap:sync:android && cd android && ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew test",
    "android:release": "pnpm cap:sync:android && cd android && ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew clean assembleRelease bundleRelease",
    "android:stage": "bash scripts/stage-android-release.sh",
    "cap:sync:ios": "pnpm build && pnpm exec cap sync ios",
    "ios:build:simulator": "pnpm cap:sync:ios && xcodebuild build -workspace IdeaTiles.xcworkspace -scheme 'Idea Tiles (iOS)' -destination 'generic/platform=iOS Simulator' IDEATILES_SKIP_CAP_SYNC=1 CODE_SIGNING_ALLOWED=NO",
    "apple:build": "pnpm cap:sync:ios && pnpm mac:generate && xcodebuild build -workspace IdeaTiles.xcworkspace -scheme 'Idea Tiles (All)' -destination 'platform=macOS,arch=arm64' IDEATILES_SKIP_CAP_SYNC=1 CODE_SIGNING_ALLOWED=NO",
    "mac:build": "vite build --config vite.mac.config.ts",
    "mac:generate": "xcodegen generate --spec macos/project.yml",
    "mac:open": "pnpm mac:generate && open IdeaTiles.xcworkspace",
    "mac:test": "pnpm mac:generate && xcodebuild test -workspace IdeaTiles.xcworkspace -scheme 'Idea Tiles (macOS)' -destination 'platform=macOS,arch=arm64' CODE_SIGNING_ALLOWED=NO",
    "mac:build:native": "pnpm mac:generate && xcodebuild build -workspace IdeaTiles.xcworkspace -scheme 'Idea Tiles (macOS)' -destination 'platform=macOS,arch=arm64' CODE_SIGNING_ALLOWED=NO",
    "mac:archive:app-store": "bash scripts/archive-mac-app-store.sh",
    "mac:archive:app-store:unsigned": "bash scripts/archive-mac-app-store.sh --unsigned",
    "mac:release:direct": "bash scripts/release-mac-direct.sh",
    "mac:release:direct:archive-only": "bash scripts/release-mac-direct.sh --archive-only",
    "mac:release:direct:preflight": "bash scripts/release-mac-direct.sh --preflight",
    "store:screenshots": "node scripts/capture-app-store-screenshots.mjs",
    "store:validate": "node scripts/validate-app-store-assets.mjs",
    "release:tools:test": "node --test scripts/release-tools.test.mjs",
    "workspace:list": "xcodebuild -list -workspace IdeaTiles.xcworkspace",
    "workspace:open": "pnpm mac:generate && open IdeaTiles.xcworkspace",
    "versions:check": "node scripts/check-apple-versions.mjs",
    "verify:canonical": "bash scripts/check-aasa.sh && bash scripts/verify-canonical-endpoints.sh"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "8.0.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/share": "^8",
    "@capacitor/splash-screen": "^8.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "jose": "6.1.0",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.15.0",
    "nanoid": "^5.1.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/react": "^16.3.2",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.34.5"
}
