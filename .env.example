# Local web server. Copy this file to .env; never commit populated secrets.
HOST=127.0.0.1
PORT=3000

# Current web client generation. Optional for opening/editing the board.
OPENAI_API_KEY=

# Optional account-backed persistence. See docs/SETUP.md before enabling.
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Optional native build overrides; public URLs only, never credentials.
# VITE_CAPACITOR_API_BASE_URL=https://your-domain.example/api
# VITE_PUBLIC_WEB_APP_URL=https://your-domain.example
