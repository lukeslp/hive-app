      27 +/**                                                            
      28 + * True when running inside the iOS Capacitor shell.           
      29 + *                                                             
      30 + * The iOS bundle is Apple-Intelligence-only by product decisio
         +n: no provider                                                 
      31 + * picker, no API keys, no cloud fallback. Web and Android keep
         + the full                                                      
      32 + * multi-provider machinery. Gate any cloud-fetch path with `if
         + (!isIos())`                                                   
      33 + * so iOS stays on FoundationModels exclusively.               
      34 + */                                                            
      35 +export function isIos(): boolean {                             
      36 +  return isCapacitor() && getPlatform() === "ios";             
      37 +}                                                              
